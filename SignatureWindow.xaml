<Window x:Class="Aso4Mail.SignatureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Signatures — Aso4Mail" Width="630" Height="510" WindowStartupLocation="CenterOwner" Background="#202227" Foreground="White" FontFamily="Segoe UI">
 <Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0"><TextBlock Text="Signatures" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Personal signature for this email account" Foreground="#B0B3BB" FontSize="12" Margin="0,5"/></StackPanel>
  <StackPanel Grid.Row="1">
   <TextBlock Text="Signature text" Foreground="#DBC08A" Margin="0,12,0,8"/>
   <TextBox x:Name="Editor" Height="170" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#2D3036" Foreground="White" BorderBrush="#4B4E55" Padding="12"/>
   <TextBlock Text="Signature image (PNG / JPEG, up to 2 MiB)" Foreground="#DBC08A" Margin="0,19,0,8"/>
   <StackPanel Orientation="Horizontal">
    <TextBox x:Name="ImagePath" IsReadOnly="True" Width="370" Padding="9" Background="#2D3036" Foreground="White"/>
    <Button Content="Choose image" Click="ChooseImage_Click" Padding="9,6" Margin="7,0"/>
    <Button Content="Remove" Click="RemoveImage_Click" Padding="9,6"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,15,0,0"><TextBlock Text="Image width" VerticalAlignment="Center"/><Slider x:Name="WidthSlider" Width="240" Minimum="50" Maximum="700" Value="220" Margin="15,0" TickFrequency="10"/><TextBlock Text="{Binding ElementName=WidthSlider,Path=Value,StringFormat={}{0:F0} px}" VerticalAlignment="Center"/></StackPanel>
  </StackPanel>
  <Button Grid.Row="2" Content="Save signature" Click="Save_Click" HorizontalAlignment="Right" Padding="17,9" Background="#CBA162" Foreground="#101010" FontWeight="Bold" Margin="0,8,0,0"/>
 </Grid>
</Window>