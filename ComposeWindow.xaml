<Window x:Class="Aso4Mail.ComposeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="New message — Aso4Mail" Width="750" Height="650" WindowStartupLocation="CenterOwner" Background="#1D1D1D" Foreground="White">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="New message" FontSize="24" Foreground="#F4BE58" Margin="0,0,0,12"/>
   <TextBlock Text="To:"/><TextBox x:Name="Recipient" Margin="0,5,0,9"/>
   <TextBlock Text="Subject:"/><TextBox x:Name="Subject" Margin="0,5,0,11"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
   <Button x:Name="SendButton" Content="Send" Click="Send_Click" Background="#694B1F" Width="100"/>
   <Button Content="Attach files" Click="Attach_Click"/>
   <TextBlock x:Name="AttachmentSummary" Foreground="#BBB" VerticalAlignment="Center" Margin="12,0"/>
  </StackPanel>
  <TextBox x:Name="Body" Background="#282828" Foreground="White" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
 </DockPanel>
</Window>