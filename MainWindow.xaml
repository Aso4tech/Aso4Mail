<Window x:Class="Aso4Mail.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aso4Mail — Business Email" Width="1440" Height="880"
 MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterScreen"
 Background="#101114" Foreground="#F3F3F3" FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A3A6AD"/>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#DBDEE4"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="15,12"/>
   <Setter Property="Margin" Value="0,2"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True">
    <Setter Property="Background" Value="#2A2D31"/>
   </Trigger></Style.Triggers>
  </Style>
  <Style x:Key="ToolbarButton" TargetType="Button">
   <Setter Property="Background" Value="#292A2D"/>
   <Setter Property="BorderBrush" Value="#424346"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Foreground" Value="#F2F2F2"/>
   <Setter Property="Padding" Value="14,10"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True">
    <Setter Property="Background" Value="#3D3A32"/>
    <Setter Property="BorderBrush" Value="#AE874A"/>
   </Trigger></Style.Triggers>
  </Style>
  <Style x:Key="MessageListItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="5,3"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="#403622"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#292D32"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="65"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="28"/>
  </Grid.RowDefinitions>
  <!-- Outlook-inspired application header -->
  <Border Grid.Row="0" Background="#17191D" BorderBrush="#363638" BorderThickness="0,0,0,1">
   <Grid Margin="20,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="37" Height="37" Background="#D49B46" CornerRadius="10" Margin="0,0,11,0">
      <TextBlock Text="✉" FontSize="20" Foreground="#191919" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel>
      <TextBlock Text="Aso4Mail" FontSize="23" FontWeight="SemiBold" Foreground="#FAFAFA"/>
      <TextBlock Text="B U S I N E S S   E M A I L" FontSize="9" Foreground="#C89B5A"/>
     </StackPanel>
    </StackPanel>
    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0,60,0" MaxWidth="620">
     <Border Background="#292B30" CornerRadius="9" BorderBrush="#484A50" BorderThickness="1"/>
     <DockPanel Margin="13,0">
      <TextBlock Text="⌕" DockPanel.Dock="Left" Foreground="#CBA164" FontSize="23" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
       Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"
       Height="41" VerticalContentAlignment="Center" ToolTip="Search loaded messages by sender or subject"/>
     </DockPanel>
    </Grid>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Padding="12,7" Background="#263027" CornerRadius="15" Margin="0,0,15,0">
      <TextBlock Text="●  Secure IMAP / TLS" Foreground="#9FD1A4" FontSize="11"/>
     </Border>
     <TextBlock Text="●" Foreground="#CDA45D" FontSize="19" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="245"/>
    <ColumnDefinition Width="385" MinWidth="310"/>
    <ColumnDefinition Width="*" MinWidth="350"/>
   </Grid.ColumnDefinitions>
   <!-- Folder navigation -->
   <Border Grid.Column="0" Background="#181B20" BorderBrush="#32353C" BorderThickness="0,0,1,0">
    <DockPanel Margin="13,15">
     <StackPanel DockPanel.Dock="Top">
      <Button Content="＋    New message" Click="Compose_Click"
       Background="#D3A257" Foreground="#171717" BorderThickness="0"
       FontSize="14" FontWeight="Bold" Padding="15,13" Cursor="Hand" Margin="0,0,0,27"/>
      <TextBlock Text="ACCOUNT" Foreground="#8C919C" FontSize="10" Margin="12,0,0,9"/>
      <ComboBox x:Name="AccountPicker" SelectionChanged="AccountPicker_SelectionChanged"
       Height="39" Background="#26292F" Foreground="#F2F2F2" Padding="7"/>
      <Button Content="+ Add account" Click="AddAccount_Click" Style="{StaticResource NavButton}" Margin="0,5,0,25"/>
      <TextBlock Text="FOLDERS" Foreground="#8C919C" FontSize="10" Margin="12,0,0,8"/>
      <Border Background="#303126" CornerRadius="8" BorderBrush="#A47D3D" BorderThickness="0,0,0,0">
       <TextBlock Text="▣    Inbox" Foreground="#F7D096" FontWeight="SemiBold" FontSize="15" Margin="14,14"/>
      </Border>
      <TextBlock Text="✉    Sent mail" Foreground="#9EA2AA" FontSize="14" Margin="15,17,0,7" ToolTip="Coming in the next development phase"/>
      <TextBlock Text="✎    Drafts" Foreground="#9EA2AA" FontSize="14" Margin="15,11,0,7" ToolTip="Coming in the next development phase"/>
      <TextBlock Text="▤    Archive" Foreground="#9EA2AA" FontSize="14" Margin="15,11,0,7" ToolTip="Coming in the next development phase"/>
      <TextBlock Text="⚑    Junk" Foreground="#9EA2AA" FontSize="14" Margin="15,11,0,7" ToolTip="Coming in the next development phase"/>
      <TextBlock Text="▧    Trash" Foreground="#9EA2AA" FontSize="14" Margin="15,11,0,7" ToolTip="Coming in the next development phase"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
      <Separator Background="#444"/>
      <Button Content="✎    Account signature" Click="Signature_Click" Style="{StaticResource NavButton}"/>
      <TextBlock Text="Aso4Mail 10.1 • Windows" FontSize="10" Foreground="#838891" Margin="12,12,0,2"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <!-- Mail list -->
   <Border Grid.Column="1" Background="#202328" BorderBrush="#343740" BorderThickness="0,0,1,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="17,19,17,10">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Inbox" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="Your latest conversations" Foreground="#9298A4" FontSize="12" Margin="0,3,0,0"/>
       </StackPanel>
       <Button Grid.Column="1" Content="↻" Click="Refresh_Click" Style="{StaticResource ToolbarButton}" FontSize="17" Margin="0,5,0,0" ToolTip="Refresh inbox"/>
      </Grid>
     </StackPanel>
     <ListBox x:Name="Messages" SelectionChanged="Messages_SelectionChanged"
      ItemContainerStyle="{StaticResource MessageListItem}"
      Background="Transparent" Foreground="White" BorderThickness="0"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate>
       <Border Background="Transparent" Padding="11,12" CornerRadius="8" BorderBrush="#343A42" BorderThickness="0,0,0,1">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Width="35" Height="35" Background="#4E4233" CornerRadius="11" VerticalAlignment="Top">
          <TextBlock Text="✉" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E7BE79" FontSize="16"/>
         </Border>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding From}" FontWeight="SemiBold" Foreground="#F3F3F3" FontSize="13" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Subject}" FontSize="13" Foreground="#D4C2A1" Margin="0,7,0,7" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding DisplayDate}" Foreground="#9499A3" FontSize="11"/>
         </StackPanel>
        </Grid>
       </Border>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <!-- Reading pane -->
   <Grid Grid.Column="2" Background="#24262B">
    <Grid.RowDefinitions>
     <RowDefinition Height="70"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" BorderBrush="#3D4045" BorderThickness="0,0,0,1">
     <DockPanel Margin="26,12" LastChildFill="False">
      <TextBlock Text="READING PANE" Foreground="#969CA6" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
       <Button Content="↻  Refresh" Click="Refresh_Click" Style="{StaticResource ToolbarButton}"/>
       <Button Content="✉  Compose" Click="Compose_Click" Style="{StaticResource ToolbarButton}"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <StackPanel Grid.Row="1" Margin="32,26,32,12">
     <TextBlock x:Name="SubjectText" Text="Select an email to read" FontSize="29" FontWeight="SemiBold" Foreground="#F5F5F5" TextWrapping="Wrap"/>
     <TextBlock x:Name="FromText" Foreground="#CBA96C" Margin="0,17,0,15" FontSize="13" TextWrapping="Wrap"/>
     <Button Content="↶  Reply" Click="Reply_Click" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left"/>
     <Separator Background="#484A4D" Margin="0,20,0,0"/>
    </StackPanel>
    <TextBox Grid.Row="2" x:Name="MessageBody"
     Background="Transparent" Foreground="#DFE1E5" BorderThickness="0"
     FontSize="14" Padding="32,10" IsReadOnly="True"
     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#141619" BorderBrush="#36383A" BorderThickness="0,1,0,0">
   <DockPanel Margin="18,0">
    <TextBlock Text="●  Encrypted connection • Messages are never sent to an Aso4Tech proxy" Foreground="#9BA1A9" FontSize="10" VerticalAlignment="Center" DockPanel.Dock="Left"/>
    <TextBlock x:Name="StatusText" Text="Ready" Foreground="#C7A667" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Right"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>