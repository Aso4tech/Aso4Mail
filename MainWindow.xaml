<Window x:Class="Aso4Mail.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Aso4Mail — Business Email" Width="1480" Height="900" MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#15171B" Foreground="#F4F4F4" FontFamily="Segoe UI">
 <Window.Resources>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Background" Value="#303238"/><Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="BorderBrush" Value="#40444C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#52442F"/><Setter Property="BorderBrush" Value="#C79B5C"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="FolderItem" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="11,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="#DEE1E5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#564630"/><Setter Property="Foreground" Value="#FFDB91"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#33383E"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="MailItem" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5,3"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#4E3C24"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#31363B"/></Trigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="59"/><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#101216" BorderBrush="#34373D" BorderThickness="0,0,0,1">
   <Grid Margin="18,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="39" Height="39" Background="#D5A14C" CornerRadius="9" Margin="0,0,10,0"><TextBlock Text="✉" Foreground="#171717" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel><TextBlock Text="Aso4Mail" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="BUSINESS EMAIL" FontSize="9" Foreground="#BE9660"/></StackPanel>
    </StackPanel>
    <DockPanel Grid.Column="1" Margin="12,12,60,12" MaxWidth="700">
     <TextBlock DockPanel.Dock="Left" Text="Search" Foreground="#ABADB0" VerticalAlignment="Center" Margin="0,0,14,0"/>
     <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="#282B31" Foreground="White" BorderBrush="#50545A" FontSize="14" VerticalContentAlignment="Center" Padding="9,5" ToolTip="Search messages currently loaded in this folder"/>
    </DockPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●  Secure SSL/TLS" Foreground="#95D3AB" Margin="0,0,22,0"/><Button Content="↻" Click="Refresh_Click" Style="{StaticResource ActionButton}" ToolTip="Sync inbox"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="#202227" BorderBrush="#373A42" BorderThickness="0,0,0,1">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="255,0,10,0">
    <Button Content="＋  New mail" Background="#D0A15D" Foreground="#1A1A1A" BorderThickness="0" FontWeight="Bold" Padding="15,9" Margin="0,0,18,0" Click="Compose_Click"/>
    <Button Content="↶  Reply" Click="Reply_Click" Style="{StaticResource ActionButton}"/>
    <Button Content="↶↶  Reply all" Click="ReplyAll_Click" Style="{StaticResource ActionButton}"/>
    <Button Content="➜  Forward" Click="Forward_Click" Style="{StaticResource ActionButton}"/>
    <Button Content="▤  Archive" Click="Archive_Click" Style="{StaticResource ActionButton}"/>
    <Button Content="▧  Delete" Click="Delete_Click" Style="{StaticResource ActionButton}"/>
    <Button Content="⚑  Junk" Click="Junk_Click" Style="{StaticResource ActionButton}"/>
    <Button Content="Empty Trash" Click="EmptyTrash_Click" Style="{StaticResource ActionButton}"/>
    <Button Content="●  Read / unread" Click="ReadToggle_Click" Style="{StaticResource ActionButton}"/>
    <Button Content="★  Flag" Click="Flag_Click" Style="{StaticResource ActionButton}"/>
    <Button Content="⋯  Save .eml" Click="SaveEml_Click" Style="{StaticResource ActionButton}"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="385"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#191C21" BorderBrush="#373A42" BorderThickness="0,0,1,0">
    <DockPanel Margin="12,16">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="YOUR ACCOUNTS" FontSize="10" Foreground="#9AA0AB" Margin="9,0,0,9"/>
      <ComboBox x:Name="AccountPicker" Height="38" Background="#33363B" Foreground="White" SelectionChanged="AccountPicker_SelectionChanged"/>
      <Button Content="＋  Add email account" Click="AddAccount_Click" Style="{StaticResource ActionButton}" Margin="0,11,0,25"/>
      <TextBlock Text="MAIL FOLDERS" FontSize="10" Foreground="#9AA0AB" Margin="9,0,0,9"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <Button Content="♙  Contacts" Style="{StaticResource ActionButton}" Margin="0,0,0,9" Click="Contacts_Click"/>
      <Button Content="✎  Account signatures" Style="{StaticResource ActionButton}" Margin="0,0,0,9" Click="Signature_Click"/>
      <Button Content="🌐  aso4tech.com" Style="{StaticResource ActionButton}" Click="Website_Click"/>
      <TextBlock Text="Aso4Mail 10.1  •  Windows" Foreground="#858A93" FontSize="10" Margin="8,17,0,0"/>
     </StackPanel>
     <ListBox x:Name="FolderList" SelectionChanged="FolderList_SelectionChanged" ItemContainerStyle="{StaticResource FolderItem}" BorderThickness="0" Background="Transparent" Foreground="White">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" FontSize="14" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="1" Background="#22252A" BorderBrush="#383B42" BorderThickness="0,0,1,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="17,20,17,12">
      <DockPanel>
       <StackPanel DockPanel.Dock="Left"><TextBlock x:Name="FolderTitle" Text="Inbox" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="FolderCount" Text="Select an account" Foreground="#A6AAB2" FontSize="11" Margin="0,3,0,0"/></StackPanel>
       <CheckBox x:Name="UnreadFilter" Content="Unread" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#D1BC96" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
      </DockPanel>
     </StackPanel>
     <ListBox x:Name="Messages" ItemContainerStyle="{StaticResource MailItem}" SelectionChanged="Messages_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><Border Padding="13,12" Background="Transparent" BorderBrush="#383B42" BorderThickness="0,0,0,1" CornerRadius="7"><Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="41"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Width="34" Height="34" CornerRadius="11" Background="#58452D" VerticalAlignment="Top"><TextBlock Text="{Binding Initials}" FontSize="12" Foreground="#FFE0A8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1">
        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#E5BB70" FontSize="10"/><TextBlock Text="{Binding From}" Foreground="#FAFAFA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="13"/></DockPanel>
        <TextBlock Text="{Binding Subject}" Foreground="#CFB891" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,7,0,4"/>
        <TextBlock Text="{Binding DisplayDate}" Foreground="#9CA1AB" FontSize="11"/>
       </StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Background="#282A2F">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="30,24,30,10">
      <TextBlock Text="READING MESSAGE" FontSize="11" Foreground="#A7ABB5" Margin="0,0,0,20"/>
      <TextBlock x:Name="SubjectText" Text="Select an email" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#F4F4F4"/>
      <TextBlock x:Name="FromText" Foreground="#D8B378" FontSize="13" Margin="0,17,0,6" TextWrapping="Wrap"/>
      <TextBlock x:Name="ToText" Foreground="#A8AEB6" FontSize="12" TextWrapping="Wrap"/>
      <Separator Background="#4C4D53" Margin="0,22,0,12"/>
     </StackPanel>
     <DockPanel Grid.Row="1" Margin="28,0,28,10">
      <TextBlock Text="Attachments:" DockPanel.Dock="Left" Foreground="#A9ADB5" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button Content="Save selected attachment" DockPanel.Dock="Right" Click="SaveAttachment_Click" Style="{StaticResource ActionButton}"/>
      <ComboBox x:Name="AttachmentPicker" MinHeight="32" Background="#33363B" Foreground="White" DisplayMemberPath="Display"/>
     </DockPanel>
     <TabControl Grid.Row="2" x:Name="BodyTabs" SelectionChanged="BodyTabs_SelectionChanged" Margin="25,5,26,18" Background="#292B30" Foreground="White" BorderThickness="0">
      <TabItem Header="Plain text"><TextBox x:Name="MessageBody" IsReadOnly="True" Background="#292B30" BorderThickness="0" Foreground="#E3E4E6" Padding="16" FontSize="14" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
      <TabItem Header="Formatted HTML"><Grid Background="#F8F8F8"><wv2:WebView2 x:Name="HtmlWebView" Visibility="Collapsed"/><TextBlock x:Name="HtmlNotice" Text="Choose a message to preview its formatting. External resources and scripts are blocked." TextWrapping="Wrap" Padding="18" Foreground="#222" VerticalAlignment="Center"/></Grid></TabItem>
     </TabControl>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="#111317"><DockPanel Margin="14,0">
   <TextBlock Text="TLS certificate validation enabled  •  Sync every 30 seconds while open" FontSize="10" Foreground="#9AA0A9" VerticalAlignment="Center"/>
   <TextBlock x:Name="StatusText" Text="Ready" DockPanel.Dock="Right" FontSize="11" Foreground="#D7AE70" VerticalAlignment="Center"/>
  </DockPanel></Border>
 </Grid>
</Window>