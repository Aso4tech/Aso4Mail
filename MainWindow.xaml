<Window x:Class="Aso4Mail.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aso4Mail" Width="1250" Height="790" MinWidth="930" MinHeight="570" Background="{StaticResource BackgroundBrush}" Foreground="White">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#101010" Padding="16">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="✉  Aso4Mail" Foreground="#F4BB53" FontSize="27" FontWeight="SemiBold" Margin="0,15,0,28"/>
     <TextBlock Text="YOUR ACCOUNTS" Foreground="#999" FontSize="11" Margin="0,0,0,7"/>
     <ComboBox x:Name="AccountPicker" SelectionChanged="AccountPicker_SelectionChanged" Height="36"/>
     <Button Content="+ Add email account" Click="AddAccount_Click" Margin="0,10,0,18"/>
     <Button Content="✉  New message" Click="Compose_Click" Background="#65451C"/>
     <Button Content="↻  Refresh inbox" Click="Refresh_Click" Margin="0,14,0,3"/>
     <Button Content="✎  Edit signature" Click="Signature_Click"/>
     <Separator Margin="0,20,0,15"/>
     <TextBlock Text="MAILBOX" FontSize="11" Foreground="#999"/>
     <TextBlock Text="Inbox" Foreground="#F4BB53" FontSize="18" Margin="6,12,0,0"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="TLS encrypted • No background service" Foreground="#AAA" FontSize="11" TextWrapping="Wrap"/>
   </DockPanel>
  </Border>
  <Border Grid.Column="1" Background="#242424" BorderBrush="#444" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="15,18,15,12">
     <TextBlock Text="Inbox" FontSize="26" FontWeight="SemiBold"/>
     <TextBox x:Name="SearchBox" Margin="0,12,0,0" TextChanged="SearchBox_TextChanged" ToolTip="Search loaded messages"/>
     <TextBlock Text="SEARCH LOADED MESSAGES" Foreground="#999" Margin="4,6,0,0" FontSize="10"/>
    </StackPanel>
    <ListBox x:Name="Messages" Background="Transparent" Foreground="White" BorderThickness="0" SelectionChanged="Messages_SelectionChanged">
     <ListBox.ItemTemplate><DataTemplate>
      <Border Background="#303030" CornerRadius="7" Padding="12" Margin="4,2">
       <StackPanel>
        <TextBlock Text="{Binding From}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Subject}" Foreground="#F3C275" Margin="0,5,0,4" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding DisplayDate}" Foreground="#AAA" FontSize="11"/>
       </StackPanel>
      </Border>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <DockPanel Grid.Column="2" Margin="25,20">
   <StackPanel DockPanel.Dock="Top">
    <TextBlock x:Name="SubjectText" Text="Select an email" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="FromText" Foreground="#C6B396" Margin="0,12,0,10" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
     <Button Content="Reply" Click="Reply_Click"/><Button Content="Compose" Click="Compose_Click"/>
    </StackPanel>
    <Separator/>
   </StackPanel>
   <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Text="Ready" Foreground="#AAA" FontSize="11" Margin="0,8,0,0"/>
   <TextBox x:Name="MessageBody" Background="Transparent" Foreground="#EEE" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0"/>
  </DockPanel>
 </Grid>
</Window>