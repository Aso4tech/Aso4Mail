<Window x:Class="Aso4Mail.ContactsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Contacts — Aso4Mail" Width="750" Height="530" MinWidth="600" MinHeight="410" WindowStartupLocation="CenterOwner" Background="#1F2126" Foreground="White">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="55"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Contacts" FontSize="27" FontWeight="SemiBold" Foreground="#E1BC7C"/><TextBlock Text="Contacts are stored locally and separately for each email account" FontSize="12" Foreground="#A7ABB2" Margin="0,6,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="ContactsList" Grid.Column="0" SelectionChanged="ContactsList_SelectionChanged" Background="#282B30" Foreground="White" BorderBrush="#494D54" Margin="0,8,16,8"/>
   <StackPanel Grid.Column="1" Margin="8,18,0,0">
    <TextBlock Text="Contact name" Margin="0,0,0,6"/>
    <TextBox x:Name="NameBox" Foreground="White" Background="#303238" Padding="9"/>
    <TextBlock Text="Email address" Margin="0,18,0,6"/>
    <TextBox x:Name="EmailBox" Foreground="White" Background="#303238" Padding="9"/>
    <StackPanel Orientation="Horizontal" Margin="0,25,0,0"><Button Content="Add / update" Click="Upsert_Click" Background="#D3A45F" Foreground="#101010" Padding="15,9"/><Button Content="Delete selected" Click="Delete_Click" Padding="15,9" Margin="10,0"/></StackPanel>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
   <Button Content="Cancel" IsCancel="True" Padding="16,9" Margin="0,0,8,0"/>
   <Button Content="Save contacts" Click="Save_Click" Padding="18,9" Background="#C89D5D" Foreground="#141414" FontWeight="Bold" IsDefault="True"/>
  </StackPanel>
 </Grid>
</Window>