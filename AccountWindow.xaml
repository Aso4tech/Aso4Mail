<Window x:Class="Aso4Mail.AccountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add email account" Width="435" Height="310" WindowStartupLocation="CenterOwner" Background="#202020" Foreground="White" ResizeMode="NoResize">
 <StackPanel Margin="27">
  <TextBlock Text="Add cPanel email account" FontSize="22" Foreground="#F3BC56" Margin="0,0,0,18"/>
  <TextBlock Text="Email address"/>
  <TextBox x:Name="Email" Margin="0,5,0,13"/>
  <TextBlock Text="Password"/>
  <PasswordBox x:Name="Password" Margin="0,5,0,17" Padding="8"/>
  <TextBlock Text="IMAP 993 • SMTP 465 • TLS required" Foreground="#AFAFAF" FontSize="11"/>
  <Button Content="Connect securely" Click="Connect_Click" Margin="0,10,0,0"/>
 </StackPanel>
</Window>