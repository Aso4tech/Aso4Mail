<Application x:Class="Aso4Mail.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Black" Color="#0F1013"/>
  <SolidColorBrush x:Key="Sidebar" Color="#181A1E"/>
  <SolidColorBrush x:Key="Panel" Color="#25272B"/>
  <SolidColorBrush x:Key="Accent" Color="#DBB17A"/>
  <SolidColorBrush x:Key="Muted" Color="#A7ADB5"/>
  <Style x:Key="ModernButton" TargetType="Button">
   <Setter Property="Background" Value="#34373B"/><Setter Property="Foreground" Value="#E8E9EC"/>
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="8"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#555046"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".78"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value=".38"/></Trigger>
     </ControlTemplate.Triggers>
    </Setter.Value></ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
  <Style x:Key="RoundedListBoxItem" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#DFE2E5"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Container" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Container" Property="Background" Value="#343A41"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Container" Property="Background" Value="#3B3934"/><Setter Property="Foreground" Value="#F1C78E"/></Trigger>
     </ControlTemplate.Triggers>
    </Setter.Value></ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ListBoxItem" BasedOn="{StaticResource RoundedListBoxItem}"/>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Background" Value="#2D3036"/><Setter Property="Foreground" Value="#F2F2F2"/>
   <Setter Property="Padding" Value="11,9"/>
   <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#4A4135"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F7F7F7"/><Setter Property="Background" Value="#303338"/>
   <Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton x:Name="DropDown" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="{TemplateBinding Background}" BorderThickness="0">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
           ContentTemplate="{Binding SelectionBoxItemTemplate,RelativeSource={RelativeSource AncestorType=ComboBox}}"
           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
          <TextBlock Grid.Column="1" Text="⌄" FontSize="17" Foreground="#D2B184" Margin="11,0,0,1" VerticalAlignment="Center"/>
         </Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#41444B"/></Trigger></ControlTemplate.Triggers>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="False"
       IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False">
       <Border Background="#282B30" BorderBrush="#4F5157" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="430">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
       </Border>
      </Popup>
     </Grid>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#2D3035"/><Setter Property="Foreground" Value="#E8EAEE"/>
   <Setter Property="BorderBrush" Value="#4A4E54"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,8"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="CaretBrush" Value="#E3B97C"/>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#AAB0BA"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Padding" Value="17,11"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Chip" CornerRadius="7" Margin="0,0,7,6" Background="#303239" Padding="{TemplateBinding Padding}">
     <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chip" Property="Background" Value="#4E402E"/><Setter Property="Foreground" Value="#F3C993"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="#41454C"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#D6D9DF"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
 </Application.Resources>
</Application>